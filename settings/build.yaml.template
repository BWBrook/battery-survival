# Template only. Activate after references, CSL, and author metadata are ready.
# Run the future build from /Users/bwbrook/work/makedoc with:
# CONFIG=/Users/bwbrook/papers/battery-survival/settings/build.yaml

default_profile: battery_survival_draft

profiles:
  battery_survival_draft:
    description: "Draft Battery Survival manuscript profile."
    manuscript_sources:
      - ../manuscript/text/main.md
      - ../manuscript/text/figures.md
    lint_sources:
      - ../manuscript/text/main.md
      - ../manuscript/text/figures.md
    author_metadata: ../manuscript/authors.yaml
    bibliography: ../references/refs.yaml
    csl: ../csl/TODO-journal-style.csl
    journal: "TODO: target journal"
    csl_search_dirs:
      - ../csl
    output_dir: dist
    output_stem: battery-survival-manuscript
    page_numbers: lower_right
    line_spacing: 1.5
    line_numbering: continuous
    review_markup:
      enabled: false
    figures:
      placement: captions_page
      caption_position: top
      placeholder_id: figures
    margins:
      unit: cm
      paper_size: a4
      top: 2.5
      right: 2.5
      bottom: 2.5
      left: 2.5
