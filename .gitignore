# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# manuscript render artifacts (source stays tracked as .qmd/.md)
manuscript/**/*.html
manuscript/**/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Project outputs and local build artifacts
.DS_Store
results/*
!results/README.md
outputs/*
!outputs/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/qc/.gitkeep
!outputs/models/.gitkeep
!outputs/manuscript/.gitkeep
_targets/
.quarto/
_freeze/

# renv local state (keep lockfile + activate script tracked)
renv/library/
renv/python/
renv/staging/

/.quarto/
**/*.quarto_ipynb
